# MongoDB Atlas connection string. URL-encode special characters in the password.
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB=food_review_platform
JWT_SECRET=
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
GOOGLE_PLACES_API_KEY=
